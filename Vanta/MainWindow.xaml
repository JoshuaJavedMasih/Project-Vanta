<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Vanta.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Vanta"
    mc:Ignorable="d">

    <Grid Background="{StaticResource VantaBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Padding="16,0,148,0" Background="{StaticResource VantaBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Image Width="24"
                   Height="24"
                   Margin="0,0,9,0"
                   Source="ms-appx:///Assets/VantaLogo.png"
                   Stretch="Uniform" />
            <TextBlock Grid.Column="1"
                       VerticalAlignment="Center"
                       FontFamily="{StaticResource VantaDisplayFontFamily}"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource VantaTextBrush}"
                       Text="Vanta" />
            <TextBlock Grid.Column="2"
                       Margin="14,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="{StaticResource VantaSubtleTextBrush}"
                       Text="System Monitoring" />
            <Border Grid.ColumnSpan="3"
                    VerticalAlignment="Bottom"
                    BorderBrush="{StaticResource VantaBorderBrush}"
                    BorderThickness="0,0,0,1" />
        </Grid>

        <Frame x:Name="RootFrame" Grid.Row="1" />
    </Grid>
</Window>
