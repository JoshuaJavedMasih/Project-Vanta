<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="VantaFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="VantaDisplayFontFamily">Segoe UI Variable Display, Segoe UI</FontFamily>

    <SolidColorBrush x:Key="VantaBackgroundBrush" Color="#070B14" />
    <SolidColorBrush x:Key="VantaSecondaryBrush" Color="#0B111D" />
    <SolidColorBrush x:Key="VantaCardBrush" Color="#111925" />
    <SolidColorBrush x:Key="VantaElevatedBrush" Color="#172131" />
    <SolidColorBrush x:Key="VantaBorderBrush" Color="#14B9C7E0" />
    <SolidColorBrush x:Key="VantaStrongBorderBrush" Color="#2B8190AA" />
    <SolidColorBrush x:Key="VantaTextBrush" Color="#F7F8FC" />
    <SolidColorBrush x:Key="VantaMutedTextBrush" Color="#ABB3C4" />
    <SolidColorBrush x:Key="VantaSubtleTextBrush" Color="#758096" />
    <SolidColorBrush x:Key="VantaAccentBrush" Color="#9A61FF" />
    <SolidColorBrush x:Key="VantaBlueBrush" Color="#4E99FF" />
    <SolidColorBrush x:Key="VantaSuccessBrush" Color="#43C966" />
    <SolidColorBrush x:Key="VantaWarningBrush" Color="#FFB547" />
    <SolidColorBrush x:Key="VantaCriticalBrush" Color="#FF5E6C" />
    <SolidColorBrush x:Key="VantaCyanBrush" Color="#5AB5FF" />

    <LinearGradientBrush x:Key="VantaCardGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#151E2B" />
        <GradientStop Offset="0.58" Color="#101824" />
        <GradientStop Offset="1" Color="#0D1521" />
    </LinearGradientBrush>

    <Style x:Key="VantaCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource VantaCardGradientBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource VantaBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="VantaElevatedCardStyle" TargetType="Border" BasedOn="{StaticResource VantaCardStyle}">
        <Setter Property="Background" Value="{StaticResource VantaElevatedBrush}" />
    </Style>

    <Style x:Key="VantaPageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource VantaDisplayFontFamily}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource VantaTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="VantaSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource VantaDisplayFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource VantaTextBrush}" />
    </Style>

    <Style x:Key="VantaEyebrowStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource VantaFontFamily}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="80" />
        <Setter Property="Foreground" Value="{StaticResource VantaAccentBrush}" />
    </Style>

    <Style x:Key="VantaMetricStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource VantaDisplayFontFamily}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource VantaTextBrush}" />
        <Setter Property="CharacterSpacing" Value="-25" />
    </Style>

    <Style x:Key="VantaBodyStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource VantaFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource VantaMutedTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="VantaPillButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#101824" />
        <Setter Property="Foreground" Value="{StaticResource VantaTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource VantaStrongBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="VantaProgressStyle" TargetType="ProgressBar">
        <Setter Property="Height" Value="3" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Background" Value="#16FFFFFF" />
    </Style>
</ResourceDictionary>
